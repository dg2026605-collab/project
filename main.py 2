GlowScript 3.2 VPython

from random import choice

scene.width = 900
scene.height = 700
scene.background = color.black
scene.center = vec(5,10,0)
scene.range = 14

ROWS = 20
COLS = 10

board = []

cells = []

score = 0

score_label = label(
    pos=vec(15,18,0),
    text='Score: 0',
    box=False,
    height=20,
    color=color.white
)

# =========================
# SHAPES
# =========================

SHAPES = {

'I':[[-1,0],[0,0],[1,0],[2,0]],

'O':[[0,0],[1,0],[0,1],[1,1]],

'T':[[-1,0],[0,0],[1,0],[0,1]],

'S':[[0,0],[1,0],[-1,1],[0,1]],

'Z':[[-1,0],[0,0],[0,1],[1,1]],

'J':[[-1,1],[-1,0],[0,0],[1,0]],

'L':[[1,1],[-1,0],[0,0],[1,0]]

}

COLORS = {
'I':color.cyan,
'O':color.yellow,
'T':color.magenta,
'S':color.green,
'Z':color.red,
'J':color.blue,
'L':color.orange
}

# =========================
# GRID
# =========================

for r in range(ROWS):

    brow = []
    crow = []

    for c in range(COLS):

        brow.append(None)

        cell = box(
            pos=vec(c,ROWS-r-1,0),
            size=vec(0.9,0.9,0.1),
            color=color.gray(0.15)
        )

        crow.append(cell)

    board.append(brow)
    cells.append(crow)

# =========================
# PIECE
# =========================

current = None
current_boxes = []

def draw_piece():

    for i in range(4):

        bx = current['blocks'][i][0] + current['x']
        by = current['blocks'][i][1] + current['y']

        current_boxes[i].pos = vec(bx,by,0)

def valid(nx,ny,blocks):

    for b in blocks:

        x = b[0] + nx
        y = b[1] + ny

        if x < 0 or x >= COLS:
            return False

        if y < 0:
            return False

        if y < ROWS:
            if board[ROWS-y-1][x] != None:
                return False

    return True

def spawn():

    global current
    global current_boxes

    name = choice(list(SHAPES.keys()))

    blocks = []

    for b in SHAPES[name]:
        blocks.append([b[0],b[1]])

    current = {
        'name':name,
        'blocks':blocks,
        'x':5,
        'y':18,
        'color':COLORS[name]
    }

    current_boxes = []

    for i in range(4):

        bb = box(
            size=vec(0.9,0.9,0.2),
            color=current['color']
        )

        current_boxes.append(bb)

    draw_piece()

def freeze():

    global score

    for i in range(4):

        x = current['blocks'][i][0] + current['x']
        y = current['blocks'][i][1] + current['y']

        if y >= ROWS:
            continue

        board[ROWS-y-1][x] = current['color']
        cells[ROWS-y-1][x].color = current['color']

    clear_lines()

    spawn()

def clear_lines():

    global score

    r = ROWS-1

    while r >= 0:

        full = True

        for c in range(COLS):

            if board[r][c] == None:
                full = False

        if full:

            score += 100

            score_label.text = 'Score: ' + str(score)

            for rr in range(r,0,-1):

                for c in range(COLS):

                    board[rr][c] = board[rr-1][c]

            for c in range(COLS):
                board[0][c] = None

        else:
            r -= 1

    for r in range(ROWS):

        for c in range(COLS):

            if board[r][c] == None:
                cells[r][c].color = color.gray(0.15)
            else:
                cells[r][c].color = board[r][c]

def move(dx,dy):

    nx = current['x'] + dx
    ny = current['y'] + dy

    if valid(nx,ny,current['blocks']):

        current['x'] = nx
        current['y'] = ny

        draw_piece()

        return True

    else:

        if dy < 0:
            freeze()

        return False

def rotate_piece():

    if current['name'] == 'O':
        return

    rotated = []

    for b in current['blocks']:

        rx = -b[1]
        ry = b[0]

        rotated.append([rx,ry])

    if valid(current['x'],current['y'],rotated):

        current['blocks'] = rotated

        draw_piece()

def hard_drop():

    while move(0,-1):
        pass

def keydown(evt):

    k = evt.key

    if k == 'left':
        move(-1,0)

    elif k == 'right':
        move(1,0)

    elif k == 'down':
        move(0,-1)

    elif k == 'up':
        rotate_piece()

    elif k == ' ':
        hard_drop()

scene.bind('keydown',keydown)

spawn()

timer = 0

while True:

    rate(60)

    timer += 0.02

    if timer > 0.5:

        timer = 0

        move(0,-1)
