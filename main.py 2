t=box()
while True :
    rate(100)
    k = keysdown()
    if 'd' in k :
        t.pos.x = t.pos.x + 0.1
    if 'a' in k :
        t.pos.x = t.pos.x - 0.1
    if 'w' in k :
        t.pos.y = t.pos.y + 0.1
    if 's' in k :
        t.pos.y = t.pos.y - 0.1
    if ' ' in k :
        t.pos = vec(0,0,0)
    if 'q' in k : 
        t.pos.z = t.pos.z + 0.1
    if 'e' in k : 
        t.pos.z = t.pos.z - 0.1
